// The scoring proxy's Worker (02.4 set it up; 01.2 made it the proxy; plan/bearings.md). Routes in src/http.ts.
// Deploy (the owner): node scripts/secrets.mjs run --only CLOUDFLARE_API_TOKEN,CLOUDFLARE_ACCOUNT_ID --
//   pnpm exec wrangler deploy --config proxy/wrangler.jsonc
// Secrets (never here; pushed by `pnpm secrets:sync`, which sends every name nexus.secrets.json binds for cloudflare):
//   OPENAI_API_KEY, BRAVE_SEARCH_API_KEY. Without both, POST /v1/score answers 503. PRESCORE_TOKEN (05.10): the owner's
//   pre-scoring secret; without it POST /v1/prescore refuses everyone (401).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mood-read-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // Workers Logs off: the proxy keeps no listener data, not even request logs (src/app/privacy.tsx). The code logs
  // nothing either.
  "observability": { "enabled": false },
  "vars": {
    // The monthly spend cap in US dollars (Open questions 6): past it, no new research run starts until next month;
    // cached books still return. Change it here and redeploy, or in the dashboard; no app rebuild.
    "MONTHLY_CAP_USD": "20",
    // The OpenAI model the research agent uses; its price per token is in src/meter.ts (unknown models price high).
    "OPENAI_MODEL": "gpt-5-mini",
    // The limits on new research runs (src/limiter.ts, A34), so made-up books and repeated rescores cannot spend the
    // cap. A cached book never counts. Per client is per connection address, held only as a salted hash for the hour.
    "RUNS_PER_CLIENT_PER_HOUR": "3",
    "RUNS_PER_HOUR": "30",
    // How many days a cached result must age before a rescore may replace it.
    "RESCORE_MIN_AGE_DAYS": "7"
  },
  // Storage for the jobs, the per-book cache, the spend meter and the run limiter (why Durable Objects: src/index.ts).
  // Declared here only: Cloudflare creates the classes on the owner's `wrangler deploy` (the migrations below); there
  // is nothing to create by hand, and no KV namespace or database id to fill in.
  "durable_objects": {
    "bindings": [
      { "name": "BOOK_JOBS", "class_name": "BookJob" },
      { "name": "SPEND_METER", "class_name": "SpendMeter" },
      // The pre-scored books' overall emotions by LibriVox number, for Browse (05.10, src/prescore.ts).
      { "name": "PRESCORED", "class_name": "PrescoreIndex" },
      // New runs per client and per hour, as salted hourly hashes (01.21, src/limiter.ts).
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BookJob", "SpendMeter"] },
    { "tag": "v2", "new_sqlite_classes": ["PrescoreIndex"] },
    { "tag": "v3", "new_sqlite_classes": ["RateLimiter"] }
  ]
}
