{
  "expo": {
    "name": "Mood Read",
    "slug": "mood-read",
    "scheme": "moodread",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moodread.app"
    },
    "android": {
      "package": "com.moodread.app",
      "adaptiveIcon": {
        "backgroundColor": "#14121a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "description": "Mood Read plays your own audiobooks with an ambient soundscape under the narration, and researches each chapter's emotions to name a fitting score."
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "scoringProxyUrl": "https://mood-read-proxy.invalid",
      "youtubeOAuthClientId": "youtube-oauth-client.invalid",
      "catalogBaseUrl": "https://pub-4a8a6c86fad24ced839c7dc3d3f4dc66.r2.dev",
      "eas": {
        "projectId": "90c02664-ad75-4ddd-9195-4d385e34be8f"
      }
    },
    "owner": "no.trbl.2.u"
  }
}
