{
  "name": "mood-read",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "description": "Mood Read: an audiobook player that scores each chapter.",
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "expo": "~58.0.17",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "58.0.9",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eas-cli": "25.3.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "wrangler": "^4.152.0"
  },
  "scripts": {
    "web": "expo start --web",
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test:run": "node --test \"src/lib/**/*.test.ts\"",
    "plan:check": "node scripts/plan-check.mjs --since HEAD",
    "secrets:scan": "node scripts/secrets.mjs scan --staged",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "build": "expo export -p web",
    "build:android:preview": "eas build --platform android --profile preview --non-interactive --wait",
    "e2e": "playwright test",
    "verify": "pnpm plan:check && pnpm secrets:scan && pnpm typecheck && pnpm lint && pnpm test:run && pnpm test:scripts && pnpm build && pnpm e2e",
    "deploy:check": "node scripts/deploy-check.mjs",
    "pulse": "node scripts/pulse.mjs",
    "settle": "node scripts/plan/settle.mjs",
    "claims": "node scripts/claims.mjs",
    "progress": "node scripts/plan/progress.mjs",
    "order": "node scripts/plan/order.mjs",
    "announce": "node scripts/announce.mjs",
    "ledger": "node scripts/ledger.mjs",
    "worktree": "node scripts/worktree.mjs",
    "secrets": "node scripts/secrets.mjs",
    "secrets:sync": "node scripts/secrets-sync.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
