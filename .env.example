# Mood Read: every secret by name. Values never go here; set them in the vault:
#   node scripts/secrets.mjs set NAME     (a hidden prompt; never an argument)
#   node scripts/secrets.mjs status       (each name, where it is set, where it goes)
# The manifest of record is nexus.secrets.json. This file only documents the names.

# Deploy gate: none until chunk 02.3 flips scripts/deploy-check.mjs to cloudflare-pages.
# DEPLOY_PROVIDER=cloudflare-pages
# CF_PAGES_PROJECT=mood-read

# Pager for stopped loops (scripts/notify.mjs), optional
# NOTIFY_NTFY_TOPIC=
# NOTIFY_WEBHOOK_URL=

BRAVE_SEARCH_API_KEY=
GH_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_S3_ACCESS_KEY_ID=
CLOUDFLARE_S3_SECRET_ACCESS_KEY=
S3_API_ENDPOINT=
KB_MCP_TOKEN=
EXPO_TOKEN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG_AUTH_TOKEN=
OPENAI_ADMIN_KEY=
OPENAI_API_KEY=
